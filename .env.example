# CinePredict AI Configuration Environment Variables

# Backend API Settings
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings
DATABASE_URL=sqlite:///./cinepredict.db

# Model Artifacts Path
MODEL_PIPELINE_PATH=./backend/ml/saved_models/cinepredict_pipeline.joblib
MODEL_METRICS_PATH=./backend/ml/saved_models/model_metrics.json

# Optional External TMDb API Key (For movie poster images and synopsis enrichments)
# Predictions operate 100% locally and do NOT require an API key.
TMDB_API_KEY=your_optional_tmdb_api_key_here

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
